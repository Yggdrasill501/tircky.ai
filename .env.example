# Copy to .env. The defaults match docker-compose.yml, so `pnpm dev:up` plus
# `pnpm db:migrate` works with this file unedited.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=tricky
POSTGRES_PASSWORD=tricky
POSTGRES_DB=tricky
# 5433, not 5432: a native Postgres on the host binds 127.0.0.1:5432, and a
# loopback-specific bind beats Docker's wildcard bind for local connections.
# Connections would silently reach the wrong server.
POSTGRES_PORT=5433
# The app connects as a NON-SUPERUSER so row-level security actually applies.
# Superusers bypass RLS unconditionally, FORCE or not.
DATABASE_URL=postgres://tricky_app:tricky_app@localhost:5433/tricky
# Owner role. Migrations, seeds and cross-user jobs only — never the request path.
DATABASE_ADMIN_URL=postgres://tricky:tricky@localhost:5433/tricky
DATABASE_POOL_MAX=10
# The non-superuser runtime role, created by scripts/ensure-local-roles.ts.
DATABASE_APP_ROLE=tricky_app
DATABASE_APP_PASSWORD=tricky_app
# Queries slower than this are logged with their SQL.
DB_SLOW_QUERY_MS=200

# --- Object storage (MinIO locally, S3/R2 in production) --------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=tricky
STORAGE_ACCESS_KEY=tricky
STORAGE_SECRET_KEY=trickytricky
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# --- App --------------------------------------------------------------------
APP_PORT=3000

# --- Claude (not used until Phase 2) ----------------------------------------
ANTHROPIC_API_KEY=
