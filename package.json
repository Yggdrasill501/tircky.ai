{
  "name": "tricky-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:all": "tsx scripts/dev-all.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "dev:up": "docker compose up -d",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f",
    "db:reset": "docker compose down -v && pnpm dev:all",
    "db:roles": "tsx scripts/ensure-local-roles.ts",
    "db:migrate:new": "kysely migrate make",
    "db:migrate:latest": "kysely migrate latest",
    "db:migrate:up": "kysely migrate up",
    "db:migrate:down": "kysely migrate down",
    "db:migrate:status": "kysely migrate list",
    "db:generate-types": "tsx scripts/generate-types.ts",
    "db:seed": "tsx scripts/seed.ts",
    "storage:init": "tsx scripts/storage-init.ts",
    "test:rls": "tsx scripts/rls-test.ts",
    "prod:up": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "kysely": "^0.29.5",
    "next": "15.5.4",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "dotenv": "^17.4.2",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "tailwindcss": "4.1.13",
    "tsx": "^4.23.13",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.15.4"
}
